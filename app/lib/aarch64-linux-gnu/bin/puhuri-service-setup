#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Install and start the Puhuri user service bundled inside this click.

Only this short-lived URL handler is unconfined. It installs user units and
starts the confined daemon through aa-exec. The main messenger remains in its
normal click AppArmor profile and invokes this helper through Lomiri's URL
Dispatcher.
"""

import json
import os
import subprocess


def app_version(root):
    installed = os.path.basename(os.path.realpath(root))
    if installed and installed not in ("app", "current"):
        return installed
    try:
        with open(os.path.join(root, "manifest.json"), encoding="utf-8") as handle:
            version = str(json.load(handle).get("version") or "")
            if version:
                return version
    except (OSError, ValueError):
        pass
    return "0.1.1"


def daemon_profile(root):
    return "fi.reijo.puhuri_puhuri-daemon_%s" % app_version(root)


def service_unit_text(root):
    """The installed unit, pointing into the click's versioned directory."""
    root = os.path.abspath(root)
    profile = daemon_profile(root)
    return """# Generated by Puhuri from the service bundled inside the click.
[Unit]
Description=Puhuri - XMPP background service
After=graphical-session.target
ConditionPathExists=%s/lib/aarch64-linux-gnu/bin/puhurid

[Service]
Type=simple
EnvironmentFile=-%%h/.config/fi.reijo.puhuri/puhurid.env
Environment=PUHURI_RESTART_AFTER_PURGE=1
Environment=PUHURI_PURGE_REQUEST_DIR=%%t/fi.reijo.puhuri
Environment=PUHURI_CLICK_WATCHDOG=1
ExecStart=/usr/bin/aa-exec -p %s -- %s/lib/aarch64-linux-gnu/bin/puhurid --engine xmpp
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
""" % (root, profile, root)


def indicator_unit_text(root):
    """The messaging-menu helper that lights the notifications indicator."""
    root = os.path.abspath(root)
    return """# Generated by Puhuri from the indicator helper inside the click.
[Unit]
Description=Puhuri - notification indicator
PartOf=puhurid.service
After=puhurid.service
ConditionPathExists=%s/lib/aarch64-linux-gnu/bin/puhuri-indicator

[Service]
Type=simple
EnvironmentFile=-%%h/.config/fi.reijo.puhuri/puhurid.env
Environment=PUHURI_PURGE_REQUEST_DIR=%%t/fi.reijo.puhuri
ExecStart=%s/lib/aarch64-linux-gnu/bin/puhuri-indicator
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
""" % (root, root)


def write_unit(unit, text):
    os.makedirs(os.path.dirname(unit), mode=0o700, exist_ok=True)
    try:
        with open(unit, "r", encoding="utf-8") as handle:
            current = handle.read()
    except OSError:
        current = ""
    if current == text:
        return
    temporary = unit + ".tmp.%d" % os.getpid()
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(temporary, unit)


def main():
    root = "/opt/click.ubuntu.com/fi.reijo.puhuri/current"
    if not os.path.isdir(root):
        root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", ".."))
    daemon = os.path.join(root, "lib", "aarch64-linux-gnu", "bin", "puhurid")
    if not os.path.isfile(daemon):
        return 1

    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config")
    units = os.path.join(config_home, "systemd", "user")
    write_unit(os.path.join(units, "puhurid.service"), service_unit_text(root))
    write_unit(os.path.join(units, "puhuri-indicator.service"), indicator_unit_text(root))

    for command in (
        ["systemctl", "--user", "daemon-reload"],
        ["systemctl", "--user", "enable", "--now", "puhurid.service"],
        ["systemctl", "--user", "enable", "--now", "puhuri-indicator.service"],
    ):
        if subprocess.run(command, check=False).returncode != 0:
            return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
