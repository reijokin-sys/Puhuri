#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Puhurin push-avustaja Ubuntu Touchille.

Lomirin push-palvelu kutsuu tätä, kun palvelimelta tulee push:

    puhuri-push-helper <sisään.json> <ulos.json>

Sisään tulee push-palvelun oma kuori (jossa on muun muassa app_id), ulos
kirjoitetaan ilmoitus, jonka järjestelmä näyttää. Tämä avustaja ei pura
viestin sisältöä - ja salattua OMEMO-viestiä se ei voisikaan purkaa ilman
avainvarastoa - vaan näyttää yleisen ilmoituksen ja herättää puhurid-palvelun
hakemaan viestit heti. Sama linja kuin muissa asiakkaissa: push kertoo että
jotain tuli, sisältö luetaan kun sovellus avataan.
"""

import json
import os
import socket
import sys


APP_ID = "fi.reijo.puhuri"
APP_NAME = "Puhuri"
# Sovelluksen oma tunniste Lomirin push-palvelussa: paketti_sovellus, sama
# jonka apparmor-profiili ja PushClient käyttävät.
PUSH_APP_ID = "fi.reijo.puhuri_puhuri"


def read_payload(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def write_payload(path, payload):
    """Kirjoita ulostulo atomisesti; jätä aina ehjä tiedosto."""
    directory = os.path.dirname(os.path.abspath(path)) or "."
    temp = path + ".tmp.%d" % os.getpid()
    try:
        with open(temp, "w", encoding="utf-8") as handle:
            json.dump(payload, handle)
        os.replace(temp, path)
    except OSError:
        try:
            os.unlink(temp)
        except OSError:
            pass


def wake_daemon():
    """Pyydä puhuridia hakemaan viestit heti (avustaja saa korkeintaan
    muutaman sekunnin, joten tämä ei koskaan jää odottamaan vastausta)."""
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    path = os.path.join(runtime, APP_ID, "socket")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(1.0)
            connection.connect(path)
            request = json.dumps({"id": 1, "cmd": "push.wake", "args": {}})
            connection.sendall((request + "\n").encode("utf-8"))
    except OSError:
        pass


def is_own_notification(payload):
    """Sovelluksen itse lähettämä ilmoitus menee sellaisenaan eteenpäin."""
    card = payload.get("card")
    if not isinstance(card, dict):
        return False
    return payload.get("app_id") == PUSH_APP_ID or card.get("summary") == APP_NAME


def main(argv):
    if len(argv) < 3:
        return 0
    source, destination = argv[1], argv[2]
    payload = read_payload(source)

    # Valmis ilmoitus: näytetään sellaisenaan.
    if is_own_notification(payload):
        write_payload(destination, payload)
        return 0

    # Herätys palvelimelta: viesti on tullut, hoidetaan haku ja näytetään
    # yleinen ilmoitus (sisältö luetaan sovelluksessa).
    card = {
        "card": {
            "summary": APP_NAME,
            "body": "Uusi viesti",
            "popup": True,
            "persist": True,
        },
        "vibrate": True,
        "emblem-counter": 1,
        # Sama tagi joka kerta, jotta ilmoitukset eivät kasaa: uusi korvaa
        # edellisen saman tunnisteen.
        "tag": "fi.reijo.puhuri.message",
        "actions": [
            {
                "id": "open",
                "label": "Avaa",
                "appid": "appid://%s/puhuri/current" % APP_ID,
            }
        ],
    }
    write_payload(destination, card)
    wake_daemon()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
