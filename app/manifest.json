{
    "name": "fi.reijo.puhuri",
    "title": "Puhuri",
    "version": "0.1.2",
    "description": "Natiivi XMPP-viestinsovellus Ubuntu Touchille",
    "maintainer": "Reijo Kinnunen",
    "framework": "ubuntu-touch-24.04-2.x",
    "architecture": "arm64",
    "icon": "assets/puhuri.png",
    "hooks": {
        "puhuri": {
            "apparmor": "fi.reijo.puhuri.apparmor",
            "desktop": "puhuri.desktop"
        },
        "puhuri-setup": {
            "apparmor": "puhuri-setup.apparmor",
            "desktop": "puhuri-setup.desktop",
            "urls": "puhuri-setup.url-dispatcher"
        },
        "puhuri-daemon": {
            "apparmor": "puhuri-daemon.apparmor",
            "desktop": "puhuri-daemon.desktop"
        },
        "push": {
            "apparmor": "push.apparmor",
            "push-helper": "push.json"
        }
    }
}
